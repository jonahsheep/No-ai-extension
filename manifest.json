{
  "manifest_version": 3,
  "name": "No AI — Block Google AI Overviews",
  "version": "0.1.0",
  "description": "Blocks Google AI Overviews.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.google.*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
