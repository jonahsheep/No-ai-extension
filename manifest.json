{
  "manifest_version": 3,
  "name": "No AI — Block Google AI Overviews",
  "version": "1.0.0",
  "description": "Automatically blocks Google AI Overviews, AI Mode, and optionally all AI content. Clean, fast, no tracking.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.co.uk/*",
    "*://*.google.co.jp/*",
    "*://*.google.co.in/*",
    "*://*.google.de/*",
    "*://*.google.fr/*",
    "*://*.google.es/*",
    "*://*.google.it/*",
    "*://*.google.ca/*",
    "*://*.google.com.au/*",
    "*://*.google.nl/*",
    "*://*.google.pl/*",
    "*://*.google.com.br/*",
    "*://*.google.ch/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "No AI — Settings",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.co.jp/*",
        "*://*.google.co.in/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.es/*",
        "*://*.google.it/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.nl/*",
        "*://*.google.pl/*",
        "*://*.google.com.br/*",
        "*://*.google.ch/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/content.css"],
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.co.jp/*",
        "*://*.google.co.in/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.es/*",
        "*://*.google.it/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.nl/*",
        "*://*.google.pl/*",
        "*://*.google.com.br/*",
        "*://*.google.ch/*"
      ]
    }
  ]
}
