{
  "manifest_version": 3,
  "name": "No AI — Block Google AI Overviews",
  "version": "0.5.0",
  "description": "Automatically blocks Google AI Overviews. Clean, fast, no tracking.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.co.*/*",
    "*://*.google.*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/*", "*://*.google.co.*/*", "*://*.google.*/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
